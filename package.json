{
  "name": "investimento",
  "version": "0.2.0",
  "description": "Pesquisa privada de investimentos: mercado, CVM, valuation e RAG documental",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node --import tsx scripts/check-db.ts",
    "format": "prettier --write src tests scripts docs *.ts *.mts *.mjs *.json README.md .github/workflows/ci.yml",
    "test:smoke": "node scripts/smoke.mjs",
    "test:live": "node --import tsx scripts/live-market.ts && node --import tsx scripts/live-cvm.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "lightweight-charts": "5.2.1",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-pgvector": "0.0.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
